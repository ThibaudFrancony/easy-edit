{
  "name": "easy-edit",
  "productName": "Easy Edit",
  "version": "0.1.0",
  "description": "Petit logiciel de montage vidéo pour macOS et Windows",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "app": "scripts/package.sh",
    "install-app": "scripts/package.sh --install",
    "icon": "node scripts/icon.mjs",
    "app:win": "scripts/package-win.sh",
    "render-server": "scripts/render-server.sh"
  },
  "build": {
    "appId": "com.thibaud.easyedit",
    "productName": "Easy Edit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/**",
      "node_modules/onnxruntime-node/bin/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dir"
      ],
      "darkModeSupport": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Easy Edit envoie les rendus au PC de la maison.",
        "NSBonjourServices": ["_easyedit-render._tcp"]
      },
      "identity": null,
      "icon": "resources/icon.icns",
      "files": [
        "!node_modules/ffmpeg-static/ffmpeg.exe",
        "!node_modules/ffprobe-static/bin/{win32,darwin/x64}/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/{win32,darwin/x64}/**"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "files": [
        "!node_modules/ffmpeg-static/ffmpeg",
        "!node_modules/ffprobe-static/bin/{darwin,win32/ia32}/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/{darwin,win32/arm64}/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Easy Edit ${version} Setup.${ext}",
      "shortcutName": "Easy Edit"
    },
    "extraResources": [
      {
        "from": "resources/fonts",
        "to": "fonts"
      },
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "*.onnx"
        ]
      }
    ]
  },
  "dependencies": {
    "@desert-ant-labs/voz": "^4.1.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "bonjour-service": "^1.4.4",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "immer": "^11.2.9",
    "motion": "^14.6.0",
    "onnxruntime-node": "^1.30.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
