{
  "name": "easy-edit",
  "productName": "Easy Edit",
  "version": "0.1.0",
  "description": "Petit logiciel de montage vidéo pour macOS",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "app": "scripts/package.sh",
    "install-app": "scripts/package.sh --install"
  },
  "build": {
    "appId": "com.thibaud.easyedit",
    "productName": "Easy Edit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/ffprobe-static/bin/{win32,linux,darwin/x64}/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/darwin/arm64/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dir"
      ],
      "darkModeSupport": true,
      "identity": null
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "immer": "^11.2.9",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
